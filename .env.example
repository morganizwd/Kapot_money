NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use http://localhost:3000 locally and your canonical https URL in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Keep this server-only and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Use one stable value across server instances for long-lived Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
